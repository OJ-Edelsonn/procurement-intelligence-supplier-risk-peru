# Copiar como .env y completar solo en el equipo local. .env no se versiona.
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=ProcurementIntelligence
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

# Se definirá una ubicación local fuera de OneDrive antes de descargar datos masivos.
DATA_ROOT=
