table 'Exposición de Proveedor'
	lineageTag: ced92810-7696-49fd-ae06-d6d75f15b20c

	measure 'Proveedores Evaluados' = COUNTROWS ( 'Exposición de Proveedor' )
		formatString: #,0
		lineageTag: 5b641074-7f43-4c16-ad31-6ba09b1d6deb

	measure 'Exposure Score Máximo' = MAX ( 'Exposición de Proveedor'[score_baseline] )
		formatString: 0.0
		lineageTag: f302a09e-2f4f-43c8-ab0e-ab67e7f08c42

	measure 'Monto Exposición PEN' = DIVIDE ( SUM ( 'Exposición de Proveedor'[award_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: 315fd6f0-a7ef-4e2b-a40e-f848da237db2

