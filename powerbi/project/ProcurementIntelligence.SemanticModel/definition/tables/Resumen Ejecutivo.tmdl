table 'Resumen Ejecutivo'
	lineageTag: 9174bb1d-32ea-46e0-9be3-45b4726c8166

	measure Procesos = MAX ( 'Resumen Ejecutivo'[process_count] )
		formatString: #,0
		lineageTag: 740cb415-9554-4ecb-b215-851fa22e4cb0

	measure 'Monto Licitado PEN' = DIVIDE ( MAX ( 'Resumen Ejecutivo'[tender_amount_pen] ), 1000000 )
