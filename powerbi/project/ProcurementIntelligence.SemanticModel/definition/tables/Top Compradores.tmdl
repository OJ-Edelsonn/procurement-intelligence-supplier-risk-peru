table 'Top Compradores'
	lineageTag: 80eabf1a-4894-4a9e-8e44-573bffa604d0

	measure 'Monto Licitado Top PEN' = DIVIDE ( SUM ( 'Top Compradores'[tender_amount_pen] ), 1000000 )
