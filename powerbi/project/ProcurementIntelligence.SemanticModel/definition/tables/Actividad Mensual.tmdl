table 'Actividad Mensual'
	lineageTag: 41dedafd-3cac-4851-a33f-7ca7fe948577

	measure 'Procesos Mensuales' = SUM ( 'Actividad Mensual'[process_count] )
		formatString: #,0
		lineageTag: 14cd3fa1-9a99-4776-ab6f-d8967cc2134f

	measure 'Monto Licitado Mensual PEN' = DIVIDE ( SUM ( 'Actividad Mensual'[tender_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: 083ea064-1777-4752-8416-b54c89a7d34e

	measure 'Monto Adjudicado Mensual PEN' = DIVIDE ( SUM ( 'Actividad Mensual'[award_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: 65a46d03-f858-4667-baf1-f268882a7024

	measure 'Monto Contractual Mensual PEN' = DIVIDE ( SUM ( 'Actividad Mensual'[contract_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: ab839bf1-cf4d-4538-908f-3e331451e96d

