table 'Oportunidad de Mercado'
	lineageTag: 63b5a9dc-2243-47d5-8398-1cc45996daf8

	measure 'Mercados Puntuados' = COUNTROWS ( 'Oportunidad de Mercado' )
		formatString: #,0
		lineageTag: b3f877a7-ced3-42d5-a089-344a40549307

	measure 'Opportunity Score Máximo' = MAX ( 'Oportunidad de Mercado'[score_baseline] )
		formatString: 0.0
		lineageTag: a8d10c02-9f61-4a2d-b0da-7917bd5e30b3

	measure 'Monto Mercados PEN' = DIVIDE ( SUM ( 'Oportunidad de Mercado'[total_category_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: d8709ebe-333f-48a9-9d5a-766696035507

