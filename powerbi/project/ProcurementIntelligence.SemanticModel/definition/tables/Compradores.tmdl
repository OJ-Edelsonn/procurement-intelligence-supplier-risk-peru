table Compradores
	lineageTag: ea85e0c2-b5e2-429b-abdf-733f44b3bef1

	measure 'Total Compradores' = COUNTROWS ( 'Compradores' )
		formatString: #,0
		lineageTag: 13ad4d02-99be-40db-80d5-28ba38d78380

	measure 'Monto Licitado Compradores PEN' = DIVIDE ( SUM ( 'Compradores'[tender_amount_pen] ), 1000000 )
		formatString: """S/ "" #,0.0 "" M"""
		lineageTag: 4b3f181d-c859-4368-9797-55a969d62b57

