	column supplier_count
		dataType: int64
		lineageTag: bbfd095b-7a58-4041-babc-17356839abdd
		summarizeBy: none
		sourceColumn: supplier_count

	column award_item_amount_pen
		dataType: double
		lineageTag: 97fb73ba-eb80-4ce2-93b2-017b0f696e77
		summarizeBy: none
		sourceColumn: award_item_amount_pen

	partition 'Top Categorías' = m
		mode: import
		source =
				let
					Source = Sql.Database("localhost\SQLEXPRESS", "ProcurementIntelligence"),
					Data = Source{[Schema="bi", Item="vw_top_categories"]}[Data]
				in
					Data

